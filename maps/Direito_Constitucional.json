          {
            "id": "nhjc3juqb5f",
            "label": "Art. 1º — Fundamentos da República (SO CI DI VAL PLU)",
            "children": [
              {
                "id": "nqw172erb5f",
                "label": "SO — Soberania (ótica interna: impor a ordem jurídica no território ·\nótica externa: dever de igualdade entre os Estados)",
                "children": []
              },
              {
                "id": "n7ogcuarb5f",
                "label": "CI — Cidadania (sentido amplo: titular de direitos fundamentais ·\nsentido estrito: titular de direitos políticos)",
                "children": []
              },
              {
                "id": "nto0gyr4b5f",
                "label": "DI — Dignidade da pessoa humana (direito à existência digna)",
                "children": []
              },
              {
                "id": "ndkuchfgb5f",
                "label": "VAL — Valores sociais do trabalho e da livre iniciativa (opção pelo modelo capitalista)",
                "children": []
              },
              {
                "id": "np95jaoqb5f",
                "label": "PLU — Pluralismo político (pluralidade de ideias; ≠ pluripartidarismo, que dele decorre)",
                "children": []
              },
              {
                "id": "npsy7o43b5f",
                "label": "Parágrafo único — soberania popular: \"todo o poder emana do povo\",\npor representantes eleitos OU diretamente (ligado ao ideal democrático)",
                "children": []
              },
              {
                "id": "nl2s7r38b5f",
                "label": "\"Cidadania\" é sempre fundamento (art. 1º, II) — nunca princípio de relações internacionais",
                "children": []
              }
            ],
