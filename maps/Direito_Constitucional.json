                "id": "nz2cwhoeb5f",
                "label": "GA — Garantir o desenvolvimento nacional",
                "children": []
              },
              {
                "id": "n1moyldhb5f",
                "label": "ER — Erradicar a pobreza e a marginalização e reduzir as desigualdades sociais e regionais",
                "children": []
              },
              {
                "id": "nrta9dl9b5f",
                "label": "PRO — Promover o bem de todos, sem preconceitos de origem, raça, sexo, cor, idade...",
                "children": []
              },
              {
                "id": "nq6nfoi3b5f",
                "label": "Verbos no infinitivo → art. 3º (chave de identificação)",
