            "id": "nuqdia9nb5f",
            "label": "Art. 2º — Separação dos Poderes",
            "children": [
              {
                "id": "n9fu27i2b5f",
                "label": "Legislativo, Executivo e Judiciário — independentes e harmônicos entre si",
                "children": []
              },
              {
                "id": "nkt0jqlvb5f",
                "label": "Visão clássica: Aristóteles (\"Política\") e Montesquieu (\"Do Espírito das Leis\")",
                "children": []
              },
              {
                "id": "n4pnye6nb5f",
                "label": "Visão moderna — funções típicas e atípicas:\nLegislativo: típicas legislar e fiscalizar · atípicas administrar e julgar\nExecutivo: típica administrar · atípicas legislar (MP) e julgar (PAD)\nJudiciário: típica julgar · atípicas administrar e legislar (regimento)",
                "children": []
              },
              {
                "id": "nenrh6fob5f",
                "label": "Freios e contrapesos (checks and balances) — controles recíprocos:\nex. nomeação de Ministro do STF, processo legislativo, controle de constitucionalidade",
                "children": []
              },
              {
                "id": "n2yc9el5b5f",
                "label": "É cláusula pétrea (art. 60, §4º, III): não pode ser abolidos\nou alterado por PEC",
                "children": []
              }
